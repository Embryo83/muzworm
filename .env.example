# Example environment variables

MONGO_URI=mongodb://localhost:27017/muzworm
SESSION_SECRET=replace_with_a_long_random_string

# Optional: create admin automatically on server startup by setting these env variables
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme

# Or create admin manually after DB is ready:
# node scripts/create-admin.js admin@example.com changeme
